  <transform>
    <type>TableInput</type>
    <name>Entrada via tabela</name>
    <sql>SELECT
  a.sigla AS area,
  t.nome AS topico,
  t.termo_busca
FROM topico_estudo AS t
JOIN area_conhecimento AS a ON a.id = t.area_id
ORDER BY a.sigla, t.nome;</sql>
