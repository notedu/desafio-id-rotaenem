<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_demonstracao_local</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Executa as cargas locais do RotaENEM para a demonstração.</description>
  <extended_description>Valida a consulta aos tópicos no PostgreSQL, carrega a amostra do ENEM no DuckDB e busca livros por tópico para a coleção conteudos no MongoDB.</extended_description>
  <created_user>RotaENEM</created_user>
  <modified_user>RotaENEM</modified_user>
