      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description>Início do fluxo de demonstração.</description>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>/home/noteedu/Projetos/Projetos Github/desafio-id-rotaenem/hop/pipelines/pl_00_teste_neon.hpl</filename>
